<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>PS Extérieur & Électricité</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO LOCAL -->
    <meta name="description" content="PS Extérieur & Électricité – Terrassement, électricité et aménagement extérieur en Belgique. Devis gratuit.">
    <meta name="keywords" content="terrassement Belgique, électricité extérieure, aménagement extérieur, entreprise terrassement">
    <meta name="author" content="PS Extérieur & Électricité">
    <meta property="og:locale" content="fr_BE">

    <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="header">
    <div class="overlay"></div>
    <div class="header-content">
        <h1>PS Extérieur & Électricité</h1>
        <p>Terrassement • Électricité • Aménagement extérieur</p>
        <a href="#devis" class="btn">Demander un devis</a>
    </div>
</header>

<section class="about">
    <h2>Notre entreprise</h2>
    <p>
        PS Extérieur & Électricité accompagne particuliers et professionnels
        dans leurs projets extérieurs, du sol à la structure.
        Travail soigné, fiable et durable.
    </p>
</section>

<section class="services">
    <h2>Nos services</h2>
    <ul>
        <li>✔ Terrassement et préparation de terrain</li>
        <li>✔ Installations électriques extérieures</li>
        <li>✔ Aménagements extérieurs complets</li>
    </ul>
</section>

<section class="devis" id="devis">
    <h2>Demande de devis gratuit</h2>

    <form>
        <input type="text" placeholder="Nom complet" required>
        <input type="email" placeholder="Adresse email" required>
        <input type="tel" placeholder="Téléphone" required>

        <select required>
            <option value="">Type de prestation</option>
            <option>Terrassement</option>
            <option>Électricité</option>
            <option>Aménagement extérieur</option>
        </select>

        <textarea placeholder="Décrivez votre projet..." required></textarea>

        <button type="submit" class="btn">Envoyer la demande</button>
    </form>
</section>

<section class="contact">
    <h2>Contact</h2>
    <p>📞 0471 / 85 60 20</p>
    <p>📧 contactps.exte@gmail.com</p>
    <p>🌐 www.psexterieur.be</p>
</section>

<footer>
    <p>© 2025 PS Extérieur & Électricité – Tous droits réservés</p>
</footer>

</body>
</html>
